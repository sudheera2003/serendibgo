// SerendibGO – single MySQL / MariaDB database
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  tourist
  provider
  vendor
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum ProviderType {
  guide
  tour_operator
  vehicle_owner
}

enum BookingType {
  package
  vehicle
}

enum BookingStatus {
  pending   // waiting for the provider
  accepted  // provider accepted, waiting for payment
  confirmed // paid
  declined
  cancelled
  completed
}

enum DeliveryType {
  hotel
  pickup
}

enum OrderStatus {
  pending_payment
  processing
  delivered
  cancelled
}

enum ItemStatus {
  pending
  packed
  dispatched
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ReviewTarget {
  package
  vehicle
  product
  destination
}

enum ReviewStatus {
  visible
  hidden
  reported
}

enum ComplaintStatus {
  open
  in_progress
  resolved
  rejected
}

enum OtpPurpose {
  verify_email
  reset_password
}

model User {
  id                Int        @id @default(autoincrement()) @map("user_id")
  role              Role
  fullName          String     @map("full_name") @db.VarChar(120)
  email             String     @unique @db.VarChar(191)
  phone             String?    @db.VarChar(30)
  passwordHash      String     @map("password_hash") @db.VarChar(100)
  preferredCurrency String     @default("LKR") @map("preferred_currency") @db.VarChar(3)
  preferredLanguage String     @default("en") @map("preferred_language") @db.VarChar(5)
  isEmailVerified   Boolean    @default(false) @map("is_email_verified")
  status            UserStatus @default(active)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  providerProfile ProviderProfile?
  vendorProfile   VendorProfile?
  documents       VerificationDocument[]
  trips           Trip[]
  bookings        Booking[]
  orders          Order[]
  checkins        DestinationCheckin[]
  reviews         Review[]
  notifications   Notification[]
  deviceTokens    DeviceToken[]
  complaints      Complaint[]            @relation("ComplaintAuthor")
  resolvedCases   Complaint[]            @relation("ComplaintResolver")
  refreshTokens   RefreshToken[]
  otps            EmailOtp[]
  auditLogs       AuditLog[]
  verifiedProviders ProviderProfile[]    @relation("ProviderVerifier")
  verifiedVendors   VendorProfile[]      @relation("VendorVerifier")

  @@map("users")
}

model ProviderProfile {
  id                 Int                @id @default(autoincrement()) @map("provider_id")
  userId             Int                @unique @map("user_id")
  providerType       ProviderType       @map("provider_type")
  businessName       String             @map("business_name") @db.VarChar(150)
  licenceNo          String?            @map("licence_no") @db.VarChar(60)
  description        String?            @db.Text
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(255)
  verifiedById       Int?               @map("verified_by")
  verifiedAt         DateTime?          @map("verified_at")
  avgRating          Decimal            @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount        Int                @default(0) @map("review_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?         @relation("ProviderVerifier", fields: [verifiedById], references: [id])
  packages   TourPackage[]
  vehicles   Vehicle[]

  @@index([verificationStatus])
  @@map("provider_profiles")
}

model VendorProfile {
  id                 Int                @id @default(autoincrement()) @map("vendor_id")
  userId             Int                @unique @map("user_id")
  shopName           String             @map("shop_name") @db.VarChar(150)
  description        String?            @db.Text
  address            String?            @db.VarChar(255)
  district           String?            @db.VarChar(60)
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(255)
  verifiedById       Int?               @map("verified_by")
  verifiedAt         DateTime?          @map("verified_at")
  avgRating          Decimal            @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount        Int                @default(0) @map("review_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?       @relation("VendorVerifier", fields: [verifiedById], references: [id])
  products   Product[]
  orderItems OrderItem[]

  @@index([verificationStatus])
  @@map("vendor_profiles")
}

model VerificationDocument {
  id         Int      @id @default(autoincrement()) @map("document_id")
  userId     Int      @map("user_id")
  docType    String   @map("doc_type") @db.VarChar(60)
  fileUrl    String   @map("file_url") @db.VarChar(500)
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model Destination {
  id          Int      @id @default(autoincrement()) @map("destination_id")
  name        String   @db.VarChar(120)
  category    String   @db.VarChar(40)
  province    String   @db.VarChar(40)
  district    String   @db.VarChar(40)
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  entryFee    Decimal  @default(0) @map("entry_fee") @db.Decimal(12, 2)
  avgRating   Decimal  @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tripStops   TripStop[]
  packages    PackageDestination[]
  checkins    DestinationCheckin[]

  @@index([name])
  @@index([category])
  @@map("destinations")
}

model Trip {
  id               Int       @id @default(autoincrement()) @map("trip_id")
  touristId        Int       @map("tourist_id")
  title            String    @db.VarChar(120)
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  startLat         Decimal?  @map("start_lat") @db.Decimal(9, 6)
  startLng         Decimal?  @map("start_lng") @db.Decimal(9, 6)
  startLabel       String?   @map("start_label") @db.VarChar(120)
  totalDistanceKm  Decimal   @default(0) @map("total_distance_km") @db.Decimal(10, 2)
  totalDurationMin Int       @default(0) @map("total_duration_min")
  estimatedCost    Decimal   @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  distanceSource   String    @default("estimate") @map("distance_source") @db.VarChar(20)
  avoidHighways    Boolean   @default(false) @map("avoid_highways")
  routeGeometry    Json?     @map("route_geometry")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tourist User       @relation(fields: [touristId], references: [id], onDelete: Cascade)
  stops   TripStop[]

  @@map("trips")
}

model TripStop {
  id             Int     @id @default(autoincrement()) @map("stop_id")
  tripId         Int     @map("trip_id")
  destinationId  Int     @map("destination_id")
  stopOrder      Int     @map("stop_order")
  legDistanceKm  Decimal @default(0) @map("leg_distance_km") @db.Decimal(10, 2)
  legDurationMin Int     @default(0) @map("leg_duration_min")

  trip        Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@unique([tripId, stopOrder])
  @@map("trip_stops")
}

model DistanceCache {
  id          Int      @id @default(autoincrement())
  originKey   String   @map("origin_key") @db.VarChar(40)
  destKey     String   @map("dest_key") @db.VarChar(40)
  distanceKm  Decimal  @map("distance_km") @db.Decimal(10, 2)
  durationMin Int      @map("duration_min")
  source      String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([originKey, destKey])
  @@map("distance_cache")
}

model TourPackage {
  id             Int      @id @default(autoincrement()) @map("package_id")
  providerId     Int      @map("provider_id")
  title          String   @db.VarChar(150)
  description    String   @db.Text
  durationDays   Int      @map("duration_days")
  pricePerPerson Decimal  @map("price_per_person") @db.Decimal(12, 2)
  maxGroupSize   Int      @map("max_group_size")
  inclusions     Json
  exclusions     Json
  imageUrl       String?  @map("image_url") @db.VarChar(500)
  cancellationPolicy String? @map("cancellation_policy") @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  avgRating      Decimal  @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount    Int      @default(0) @map("review_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  provider     ProviderProfile      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  destinations PackageDestination[]
  bookings     Booking[]

  @@map("tour_packages")
}

model PackageDestination {
  packageId     Int @map("package_id")
  destinationId Int @map("destination_id")
  dayNo         Int @map("day_no")

  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@id([packageId, destinationId])
  @@map("package_destinations")
}

model Vehicle {
  id              Int      @id @default(autoincrement()) @map("vehicle_id")
  providerId      Int      @map("provider_id")
  vehicleType     String   @map("vehicle_type") @db.VarChar(30)
  makeModel       String   @map("make_model") @db.VarChar(80)
  seats           Int
  withDriver      Boolean  @map("with_driver")
  pricePerDay     Decimal  @map("price_per_day") @db.Decimal(12, 2)
  pricePerKm      Decimal  @map("price_per_km") @db.Decimal(12, 2)
  driverFeePerDay Decimal  @default(0) @map("driver_fee_per_day") @db.Decimal(12, 2)
  baseLocation    String   @map("base_location") @db.VarChar(80)
  imageUrl        String?  @map("image_url") @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  avgRating       Decimal  @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount     Int      @default(0) @map("review_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([vehicleType])
  @@map("vehicles")
}

model Booking {
  id          Int           @id @default(autoincrement()) @map("booking_id")
  touristId   Int           @map("tourist_id")
  bookingType BookingType   @map("booking_type")
  packageId   Int?          @map("package_id")
  vehicleId   Int?          @map("vehicle_id")
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  numPersons  Int           @default(1) @map("num_persons")
  estimatedKm Decimal       @default(0) @map("estimated_km") @db.Decimal(10, 2)
  priceBreakdown Json       @map("price_breakdown")
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  status      BookingStatus @default(pending)
  notes       String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tourist  User         @relation(fields: [touristId], references: [id])
  package  TourPackage? @relation(fields: [packageId], references: [id])
  vehicle  Vehicle?     @relation(fields: [vehicleId], references: [id])
  payments Payment[]
  review   Review?

  @@index([vehicleId, startDate, endDate])
  @@index([packageId, startDate])
  @@map("bookings")
}

model ProductCategory {
  id          Int       @id @default(autoincrement()) @map("category_id")
  name        String    @unique @db.VarChar(60)
  description String?   @db.VarChar(255)
  products    Product[]

  @@map("product_categories")
}

model Product {
  id          Int      @id @default(autoincrement()) @map("product_id")
  vendorId    Int      @map("vendor_id")
  categoryId  Int      @map("category_id")
  name        String   @db.VarChar(150)
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stockQty    Int      @map("stock_qty")
  imageUrls   Json     @map("image_urls")
  isActive    Boolean  @default(true) @map("is_active")
  avgRating   Decimal  @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount Int      @default(0) @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor     VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([name])
  @@map("products")
}

model Order {
  id              Int          @id @default(autoincrement()) @map("order_id")
  touristId       Int          @map("tourist_id")
  totalAmount     Decimal      @map("total_amount") @db.Decimal(12, 2)
  deliveryType    DeliveryType @map("delivery_type")
  hotelName       String?      @map("hotel_name") @db.VarChar(150)
  deliveryAddress String?      @map("delivery_address") @db.VarChar(255)
  status          OrderStatus  @default(pending_payment)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tourist  User        @relation(fields: [touristId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id         Int        @id @default(autoincrement()) @map("order_item_id")
  orderId    Int        @map("order_id")
  productId  Int        @map("product_id")
  vendorId   Int        @map("vendor_id")
  quantity   Int
  unitPrice  Decimal    @map("unit_price") @db.Decimal(12, 2)
  itemStatus ItemStatus @default(pending) @map("item_status")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
  vendor  VendorProfile @relation(fields: [vendorId], references: [id])
  review  Review?

  @@index([vendorId, itemStatus])
  @@map("order_items")
}

model Payment {
  id         Int           @id @default(autoincrement()) @map("payment_id")
  bookingId  Int?          @map("booking_id")
  orderId    Int?          @map("order_id")
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("LKR") @db.VarChar(3)
  gatewayRef String        @unique @map("gateway_ref") @db.VarChar(60)
  method     String?       @db.VarChar(30)
  status     PaymentStatus @default(pending)
  paidAt     DateTime?     @map("paid_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model DestinationCheckin {
  id            Int      @id @default(autoincrement()) @map("checkin_id")
  touristId     Int      @map("tourist_id")
  destinationId Int      @map("destination_id")
  latitude      Decimal  @db.Decimal(9, 6)
  longitude     Decimal  @db.Decimal(9, 6)
  distanceM     Int      @map("distance_m")
  checkedInAt   DateTime @default(now()) @map("checked_in_at")

  tourist     User        @relation(fields: [touristId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
  review      Review?

  @@map("destination_checkins")
}

model Review {
  id            Int          @id @default(autoincrement()) @map("review_id")
  touristId     Int          @map("tourist_id")
  targetType    ReviewTarget @map("target_type")
  targetId      Int          @map("target_id")
  bookingId     Int?         @unique @map("booking_id")
  orderItemId   Int?         @unique @map("order_item_id")
  checkinId     Int?         @unique @map("checkin_id")
  rating        Int          @db.TinyInt
  comment       String?      @db.Text
  photoUrls     Json?        @map("photo_urls")
  status        ReviewStatus @default(visible)
  reportReason  String?      @map("report_reason") @db.VarChar(255)
  providerReply String?      @map("provider_reply") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  tourist   User                @relation(fields: [touristId], references: [id])
  booking   Booking?            @relation(fields: [bookingId], references: [id])
  orderItem OrderItem?          @relation(fields: [orderItemId], references: [id])
  checkin   DestinationCheckin? @relation(fields: [checkinId], references: [id])

  @@index([targetType, targetId, status])
  @@map("reviews")
}

model Notification {
  id            Int      @id @default(autoincrement()) @map("notification_id")
  userId        Int      @map("user_id")
  title         String   @db.VarChar(150)
  body          String   @db.VarChar(500)
  type          String   @db.VarChar(40)
  referenceType String?  @map("reference_type") @db.VarChar(40)
  referenceId   Int?     @map("reference_id")
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model DeviceToken {
  id            Int      @id @default(autoincrement()) @map("token_id")
  userId        Int      @map("user_id")
  expoPushToken String   @unique @map("expo_push_token") @db.VarChar(200)
  platform      String   @db.VarChar(10)
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Complaint {
  id             Int             @id @default(autoincrement()) @map("complaint_id")
  touristId      Int             @map("tourist_id")
  targetType     String          @map("target_type") @db.VarChar(30)
  targetId       Int?            @map("target_id")
  subject        String          @db.VarChar(150)
  description    String          @db.Text
  status         ComplaintStatus @default(open)
  resolvedById   Int?            @map("resolved_by")
  resolutionNote String?         @map("resolution_note") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tourist    User  @relation("ComplaintAuthor", fields: [touristId], references: [id])
  resolvedBy User? @relation("ComplaintResolver", fields: [resolvedById], references: [id])

  @@map("complaints")
}

model RefreshToken {
  id        Int       @id @default(autoincrement()) @map("token_id")
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(100)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailOtp {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  purpose   OtpPurpose
  codeHash  String     @map("code_hash") @db.VarChar(100)
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_otps")
}

model ExchangeRate {
  currencyCode String   @id @map("currency_code") @db.VarChar(3)
  rateToLkr    Decimal  @map("rate_to_lkr") @db.Decimal(14, 6)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

model AuditLog {
  id         Int      @id @default(autoincrement()) @map("log_id")
  actorId    Int      @map("actor_id")
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
