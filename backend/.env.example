# --- Server ---
NODE_ENV=development
PORT=4000
# Public URL of this API. Phones must be able to reach it (use your PC's LAN IP, e.g. http://192.168.1.20:4000)
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=*

# --- Database (single MySQL / MariaDB database) ---
DATABASE_URL=mysql://root:@localhost:3306/serendibgo

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# --- Google Maps Platform (optional; without it distances are estimated from coordinates) ---
GOOGLE_MAPS_API_KEY=
# --- OpenRouteService fallback (optional) ---
ORS_API_KEY=

# --- PayHere (optional; without it the built-in payment simulator is used) ---
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# --- E-mail (optional; without it OTP codes are printed in the server log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SerendibGO <no-reply@serendibgo.lk>"

# --- Trip cost estimate ---
TRANSPORT_RATE_PER_KM=120

# --- Image storage (optional; without it uploads are saved in ./uploads) ---
# Find it on the Cloudinary dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
