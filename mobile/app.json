{
  "expo": {
    "name": "SerendibGO",
    "slug": "serendibgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "serendibgo",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.serendibgo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SerendibGO uses your location to check you in at destinations and to plan trips from where you are."
      }
    },
    "android": {
      "package": "lk.serendibgo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F766E"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SerendibGO uses your location to check you in at destinations and to plan trips from where you are."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SerendibGO needs your photos to add pictures to listings, documents and reviews."
        }
      ],
      "expo-notifications",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
